# MOSAIC configuration. Copy to .env and edit. NEVER commit a filled .env.
# All values are optional: defaults live in mosaic.settings.config.Settings.

# --- paths -----------------------------------------------------------------
MOSAIC_DATA_ROOT=data
MOSAIC_CACHE_ROOT=var/cache
MOSAIC_DB_URL=sqlite:///var/mosaic.sqlite
# Postgres is fully supported but optional for local research runs:
# MOSAIC_DB_URL=postgresql+psycopg2://mosaic:mosaic@localhost:5432/mosaic

# --- runtime ---------------------------------------------------------------
MOSAIC_LOG_LEVEL=INFO
MOSAIC_LOG_FORMAT=text          # text | json
MOSAIC_SEED=20260901
MOSAIC_N_JOBS=-1                # -1 = all cores for library-level parallelism

# --- api -------------------------------------------------------------------
MOSAIC_API_HOST=127.0.0.1
MOSAIC_API_PORT=8000
MOSAIC_API_CORS_ORIGINS=["http://localhost:5173"]

# --- research defaults -----------------------------------------------------
MOSAIC_DEFAULT_FPR_TARGET=0.01  # false-positive rate cap used for threshold selection
MOSAIC_DEFAULT_SEEDS=[11,23,37,59,71]
